# Writes the live Claude Code sessions to this boot's roster (session_relaunch.py snapshot); started by ns-session-roster.timer.
[Unit]
Description=Snapshot the live Claude Code sessions for a relaunch after an unplanned restart

[Service]
Type=oneshot
CPUWeight=idle
TimeoutStartSec=90
ExecStart=/usr/bin/python3 -I %h/.local/share/native-agent-stack/session-relaunch/session_relaunch.py snapshot --config %h/.local/state/native-agent-stack/session-relaunch/config.json
