# Once per boot: relaunch the sessions of an earlier boot's roster when that boot ended without a planned-restart marker.
[Unit]
Description=Relaunch the core Claude Code sessions after an unplanned WSL restart

[Service]
Type=oneshot
TimeoutStartSec=900
ExecStart=/usr/bin/python3 -I %h/.local/share/native-agent-stack/session-relaunch/session_relaunch.py relaunch --config %h/.local/state/native-agent-stack/session-relaunch/config.json

[Install]
WantedBy=default.target
