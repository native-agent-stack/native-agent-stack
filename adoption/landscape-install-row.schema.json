{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoption/landscape-install-row.schema.json",
  "title": "Landscape install manifest row",
  "description": "One screened candidate that NativeHorizonNY installs once in stage H: its exact pin, the screens it passed, the vendor-path install, check and inverse commands as argv (never prose or a shell string), the plan services it dials, the record of the models it selects, its invoke identity, its suited roles, its start-up context cost and its TRIAL or FINAL label. A PROPOSAL routed to the layer-resolution protocol; see docs/decisions/2026-10-16-landscape-install-manifest.md. The manifest of these rows lives in horizon, which pins this schema by commit. Install, check and inverse runs are recorded as host receipts (adoption/host-receipt.schema.json).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "candidate",
    "pin",
    "screens",
    "route",
    "install",
    "check",
    "inverse",
    "sources",
    "models",
    "invoke",
    "roles",
    "startup_context_cost",
    "label"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 128,
      "description": "Stable row id, used as the component_id of the row's host receipts"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "name"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/https_url"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "package_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "description": "An exact version plus an immutable identity: the source commit, or a release artifact with its sha256",
      "properties": {
        "version": {
          "type": "string",
          "description": "An exact version: three numeric components, then optional pre-release or build parts. A wildcard segment, a comparator, a range or a channel name (latest, canary, nightly) is refused",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+[0-9A-Za-z]*(?:[.+_-][0-9A-Za-z]+)*$",
          "not": {
            "pattern": "(^|[.+_-])[xX](?=$|[.+_-])"
          }
        },
        "tag": {
          "$ref": "#/$defs/text"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "sha256"
          ],
          "properties": {
            "url": {
              "$ref": "#/$defs/https_url"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "commit"
          ]
        },
        {
          "required": [
            "artifact"
          ]
        }
      ]
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Every screen row this pin passed: one candidate installs once however many layers and families screened it",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer",
          "family",
          "table",
          "candidate",
          "verdict"
        ],
        "properties": {
          "layer": {
            "type": "string",
            "pattern": "^(foundation|us-equities)/[a-z0-9-]+$",
            "description": "<catalog>/<layer_id>"
          },
          "family": {
            "enum": [
              "anthropic",
              "openai",
              "meta",
              "research"
            ]
          },
          "table": {
            "$ref": "#/$defs/file_name"
          },
          "candidate": {
            "$ref": "#/$defs/text"
          },
          "verdict": {
            "const": "PASS"
          }
        }
      }
    },
    "route": {
      "description": "The vendor-path family the commands use. It fixes the install plan stage the row follows (C for a host tool, D for a client-level install, S for a user service) and what the install argv must bind: the exact version (mise, uv-tool, uv-add, npm-global, claude-mcp, codex-mcp, vendor-installer), the commit (skills-cli, claude-plugin, codex-plugin) or the verified artifact (vendor-installer, systemd-user)",
      "enum": [
        "mise",
        "uv-tool",
        "uv-add",
        "npm-global",
        "claude-plugin",
        "claude-mcp",
        "codex-plugin",
        "codex-mcp",
        "skills-cli",
        "systemd-user",
        "vendor-installer"
      ]
    },
    "install": {
      "$ref": "#/$defs/argv_list"
    },
    "check": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "inverse": {
      "$ref": "#/$defs/argv_list"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install",
        "check",
        "inverse"
      ],
      "description": "Where each command is documented, at a pin: the candidate's own docs, or the route tool's where the candidate documents none",
      "properties": {
        "install": {
          "$ref": "#/$defs/citation"
        },
        "check": {
          "$ref": "#/$defs/citation"
        },
        "inverse": {
          "$ref": "#/$defs/citation"
        }
      }
    },
    "dials": {
      "type": "array",
      "uniqueItems": true,
      "description": "The install plan's service slots this candidate dials (for example the gateway): no run, trial or comparison of the row starts before stage S proves that slot's listener on this host",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "models": {
      "type": "array",
      "uniqueItems": true,
      "description": "The record of each model the row selects: its catalogs/foundation/model-currency.json slug, the selected model id that slug maps to, and where it is selected. Empty when the row selects none. A record, never a gate: a stale selection shows in the session-start currency notice",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "model_id",
          "selector"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$"
          },
          "model_id": {
            "$ref": "#/$defs/token"
          },
          "selector": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "where",
              "key"
            ],
            "properties": {
              "where": {
                "enum": [
                  "argv",
                  "config",
                  "sdk-option"
                ]
              },
              "key": {
                "$ref": "#/$defs/token"
              }
            }
          }
        }
      }
    },
    "invoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "names"
      ],
      "description": "What the invoke tracking counts for this row, so zero calls is a wiring finding",
      "properties": {
        "kind": {
          "enum": [
            "skill",
            "plugin",
            "mcp-server",
            "cli",
            "sdk",
            "service"
          ]
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/token"
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Suited roles, the rows of the install plan's role-assignment matrix (Decision 9). A fenced session (an account trader, a blind judge or reviewer, a paired-run control arm) and Jev take no framework, so they are never a role here",
      "items": {
        "enum": [
          "builder",
          "reviewer",
          "auditor",
          "researcher",
          "command-center",
          "co-op",
          "worker-pi",
          "worker-opencode",
          "worker-muse"
        ]
      }
    },
    "startup_context_cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "basis",
        "method"
      ],
      "properties": {
        "tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "null when no total is known"
        },
        "basis": {
          "enum": [
            "measured",
            "estimate"
          ]
        },
        "method": {
          "$ref": "#/$defs/text"
        },
        "receipt": {
          "$ref": "#/$defs/file_name"
        }
      }
    },
    "label": {
      "enum": [
        "TRIAL",
        "FINAL"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "const": "FINAL"
          }
        }
      },
      "then": {
        "properties": {
          "startup_context_cost": {
            "required": [
              "receipt"
            ],
            "properties": {
              "tokens": {
                "type": "integer"
              },
              "basis": {
                "const": "measured"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "route"
        ],
        "properties": {
          "route": {
            "enum": [
              "vendor-installer",
              "systemd-user"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pin": {
            "required": [
              "artifact"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "route"
        ],
        "properties": {
          "route": {
            "enum": [
              "skills-cli",
              "claude-plugin",
              "codex-plugin"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pin": {
            "required": [
              "commit"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "https_url": {
      "type": "string",
      "pattern": "^https://[^/@\\s]+(/\\S*)?$",
      "description": "No user information before the host, so no credential rides in a URL"
    },
    "file_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": {
        "pattern": "^[0-9a-f]{12,}$"
      },
      "description": "A file name only: a record is cited by name, never by digest or private path"
    },
    "shell": {
      "type": "string",
      "pattern": "(^|/)(sh|bash|zsh|dash|ksh|mksh|fish|csh|tcsh|eval)$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "description": "One command as argv. No element is a shell, so no command is a shell string; the generator quotes each element when it records the command. The token {artifact} is the verified download of pin.artifact, as the program or as an argument",
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[^\\s;&|<>`$()]+$",
          "not": {
            "$ref": "#/$defs/shell"
          }
        }
      ],
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "$ref": "#/$defs/shell"
        }
      }
    },
    "argv_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/argv"
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "absent_by"
      ],
      "properties": {
        "argv": {
          "$ref": "#/$defs/argv"
        },
        "expect_exit": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "stdout_contains": {
          "$ref": "#/$defs/text"
        },
        "absent_by": {
          "description": "How the cleanup stage proves the candidate is gone: exit (the check returns absent_exit) or text (the check returns expect_exit without stdout_contains). A check with neither documented cannot be a row's check",
          "enum": [
            "exit",
            "text"
          ]
        },
        "absent_exit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "absent_by": {
                "const": "exit"
              }
            },
            "required": [
              "absent_by"
            ]
          },
          "then": {
            "required": [
              "absent_exit"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "absent_by": {
                "const": "text"
              }
            },
            "required": [
              "absent_by"
            ]
          },
          "then": {
            "required": [
              "stdout_contains"
            ]
          }
        }
      ]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "description": "A source at a pin: the commit it was read at, or, for a client's help text, the client version and the time it was read",
      "properties": {
        "url": {
          "$ref": "#/$defs/https_url"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]*$"
        },
        "path": {
          "$ref": "#/$defs/text"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "read_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      },
      "anyOf": [
        {
          "required": [
            "commit"
          ]
        },
        {
          "required": [
            "version",
            "read_at_utc"
          ]
        }
      ]
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9@-][A-Za-z0-9@._/:+=-]*$",
      "maxLength": 200
    }
  }
}
