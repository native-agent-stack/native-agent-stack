# Mirrors the timer installed on NativeHorizonNY beside
# nhny-cc-verdict-publish.service; see that service template in this directory
# for the placeholder and install notes that also apply here. The next run is
# 60 s after the previous one finishes (OnUnitInactiveSec=), so runs never
# overlap, and nothing needs catching up: every run re-scans the whole source
# root.
[Unit]
Description=Publish newly sealed CC verdicts to the 2604 staging root (an input-existence trigger, every 60 s)

[Timer]
OnBootSec=2min
OnUnitInactiveSec=60s
AccuracySec=5s

[Install]
WantedBy=timers.target
