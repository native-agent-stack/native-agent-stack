# Loopback-only listener census (docs/decisions/2026-10-17-loopback-listener-census.md). loopback-census.timer starts
# it every 5 minutes.
#
# It runs scripts/loopback_census.py, which runs `ss -H -l -t -u -n -p` (iproute2 ss(8)) with a 30 s timeout. The exit
# codes:
#   0: every TCP and UDP listener binds loopback (127.0.0.0/8, ::1 or ::ffff:127.0.0.0/104), apart from WSL's DNS
#      tunnel at 10.255.255.254:53;
#   1: a breach;
#   2: a census error: ss is missing, failing or hung, ss listed no listener, a line did not parse, or the state
#      directory could not be written.
# So a broken census never reports clean.
#
# Either failure starts stack-alert@%n.service through OnFailure=. That handler sends the command center one named hcom
# message with a journal pointer, as in mineru.service.
#
# The script writes the run's JSON to $XDG_STATE_HOME/loopback-census/last.json. StateDirectory= creates that directory
# (systemd.exec(5)), and %S is its root in user mode (systemd.unit(5)). A run whose violations differ from the previous
# run's also keeps them there as breaches/<UTC stamp>.json. The script's stderr states the breach count or the error,
# then names that record. StandardError=journal sends those lines to the journal, so the alert's journal pointer leads to
# them.
#
# TimeoutStartSec=60 fails the unit, and so alerts, if a run hangs. Without it, Type=oneshot has no start timeout
# (systemd.service(5)).
#
# @REPOSITORY@ is the checkout that holds scripts/loopback_census.py. On the workstation that is the live clone,
# %h/code/native-agent-stack-live, as for stack-currency.service. Never use the working checkout, whose revision moves,
# or a build worktree. Install, check and activate, in this order:
#   sed 's#@REPOSITORY@#%h/code/native-agent-stack-live#g' adoption/templates/systemd/loopback-census.service > ~/.config/systemd/user/loopback-census.service
#   cp adoption/templates/systemd/loopback-census.timer ~/.config/systemd/user/
#   systemd-analyze --user verify ~/.config/systemd/user/loopback-census.service ~/.config/systemd/user/loopback-census.timer
#   systemctl --user show -p LoadState --value stack-alert@loopback-census.service.service   # must print: loaded
#   systemctl --user daemon-reload
#   systemctl --user disable --now nhny-loopback-census.timer   # the shell precursor, where it runs
#   systemctl --user enable --now loopback-census.timer
#   systemctl --user list-timers loopback-census.timer          # read back the next run
#
# It has no [Install] section, because this directory's timer-triggered oneshots have none; the timer has one. UMask=0077,
# NoNewPrivileges=true and the idle scheduling settings match this directory's other oneshots.
[Unit]
Description=Loopback-only listener census (alerts on any non-loopback listener)
OnFailure=stack-alert@%n.service

[Service]
Type=oneshot
TimeoutStartSec=60
UMask=0077
NoNewPrivileges=true
Nice=19
IOSchedulingClass=idle
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=loopback-census
StandardOutput=null
StandardError=journal
ExecStart=/usr/bin/python3 @REPOSITORY@/scripts/loopback_census.py --state-dir %S/loopback-census
