# Render @REPOSITORY@ to the live main clone, matching skill-invoke-rate.service.
# Render @PYTHON@ and @NODE@ to installed interpreter paths. The CC installs
# this file after landing; the authoring lane runs fixture tests only.
[Unit]
Description=Daily native token-rate projection

[Service]
Type=oneshot
WorkingDirectory=@REPOSITORY@
UMask=0077
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=30min
ExecStart="@PYTHON@" "@REPOSITORY@/tools/skill-usage/daily_token_usage.py" --node "@NODE@" --codex-root %h/.codex/sessions --claude-root %h/.claude/projects --out %h/.local/state/native-agent-stack/coordination/command-center/skills/token-rate-latest.json --history %h/.local/state/native-agent-stack/coordination/command-center/skills/token-rate-history.json
