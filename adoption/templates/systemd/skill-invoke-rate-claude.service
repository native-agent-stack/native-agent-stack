# The Claude Code half of the daily skill record: the native /skill-doctor capture (lifetime uses per skill) and the child-usage.mjs --lanes-sweep Skill calls. The Codex half is skill-invoke-rate-codex.service;
# each has its own timeouts and its own record, so a slow Codex scan never leaves this half unmeasured (docs/decisions/2026-10-12-skill-invoke-rate-timer.md).
# Render @REPOSITORY@ to the live clone, %h/code/native-agent-stack-live, matching stack-currency.service: a detached worktree of origin/main, which
# daily_skill_usage.py accepts (any commit of origin/main; it refuses a feature branch and commits of the clone's own, and so does --render-units).
# Render @PYTHON@ and @NODE@ to installed interpreter paths:
#   python3 tools/skill-usage/daily_skill_usage.py --render-units <dir> --repository %h/code/native-agent-stack-live --python <python> --node <node>
# The CC installs this file after landing; the authoring lane runs fixture tests only. TimeoutStartSec exceeds the sum of the half's command limits
# (daily_skill_usage.py half_budget; a test pins it): the capture 300 s + 60 s, the sweep 600 s, and a minute of margin.
[Unit]
Description=Daily native skill invocation report, Claude Code half

[Service]
Type=oneshot
WorkingDirectory=@REPOSITORY@
UMask=0077
Nice=10
# Writes: the record directory below and nothing else (the half's own record, the combined record the Fleet page reads, and the lock that serialises the combined refresh; both halves write the same directory).
# ProtectSystem=strict mounts the whole file hierarchy read-only, ProtectHome=read-only does the same for the home directory (the live clone and the client's own state included), and ReadWritePaths= opens the one
# directory that is written (systemd.exec(5), systemd 259.5). In a user service these need unprivileged user namespaces, which the user manager enables itself when PrivateUsers= is not set; PrivateUsers=true asks for
# them, so that a manager that cannot create the user namespace fails the unit (status 217/USER) instead of ignoring it (systemd/systemd-stable@387a14a7b67b, v255.4, src/core/exec-invoke.c L4595-L4609). That is the
# only case it covers. A manager that creates the user namespace but cannot create the mount namespace in it, or runs where a container or a security module denies it, starts the unit without ProtectSystem= and
# the others and says nothing (exec-invoke.c L3212-L3237, src/core/namespace.c L2488-L2497; the manual calls these features "gracefully turned off", systemd/systemd@e846bbad man/systemd.exec.xml L1476; measured on the
# GitHub-hosted runner, docs/decisions/2026-10-12-skill-invoke-rate-timer.md), so the program asks the file system first: --refuse-writable makes it try to create a file in the home directory and in the clone,
# and it exits 2 before any work unless the file system answers EROFS, the answer of the read-only mounts these directives make; a refusal by a mode or a policy (EACCES, EPERM) shows nothing about them. It
# probes the top of each directory once, when it starts: the directives are the boundary and this tells a unit started without them from one started with them. The directory must exist before the unit starts (mkdir -m 0700 -p): ReadWritePaths= without a leading "-" fails closed on a missing path.
# PYTHONDONTWRITEBYTECODE=1 reaches every interpreter the service starts (-B on the parent alone would not), and PrivateTmp=true gives the client its own temporary directory under ProtectSystem=strict.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/native-agent-stack/coordination/command-center/skills
PrivateTmp=true
PrivateUsers=true
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=17min
ExecStart="@PYTHON@" "@REPOSITORY@/tools/skill-usage/daily_skill_usage.py" --refuse-writable %h --refuse-writable "@REPOSITORY@" --half claude --node "@NODE@" --claude-root %h/.claude/projects --window 7 --out %h/.local/state/native-agent-stack/coordination/command-center/skills/skill-invoke-rate-claude-latest.json --combined-out %h/.local/state/native-agent-stack/coordination/command-center/skills/skill-invoke-rate-latest.json --other-record %h/.local/state/native-agent-stack/coordination/command-center/skills/skill-invoke-rate-codex-latest.json
