[
  "systemd-run",
  "--user",
  "--scope",
  "-p",
  "CPUWeight=idle",
  "--quiet",
  "--",
  "env",
  "-i",
  "HOME=<FOLD_SCRATCH>/home",
  "PATH=/usr/local/bin:/usr/bin:/bin",
  "TMPDIR=<FOLD_SCRATCH>/tmp",
  "UV_CACHE_DIR=<FOLD_SCRATCH>/cache",
  "UV_PROJECT_ENVIRONMENT=<FOLD_SCRATCH>/envs/kumo",
  "<UV_BIN>",
  "sync",
  "--locked",
  "--all-extras",
  "--python",
  "<RECORDER_PYTHON>"
]
